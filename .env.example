# App
APP_ENV=development          # development | staging | production
APP_PORT=8001
SECRET_KEY=changeme

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=           # local dev only - prod uses IAM role
AWS_SECRET_ACCESS_KEY=       # local dev only - prod uses IAM role
DYNAMODB_ENDPOINT_URL=http://localhost:8000   # local dev only - unset in prod

# DynamoDB
DYNAMODB_TABLE_AGENTS=panasa-agents
DYNAMODB_TABLE_TEMPLATES=panasa-templates
DYNAMODB_TABLE_SESSIONS=panasa-sessions
DYNAMODB_TABLE_AUDIT=panasa-audit

# Postgres (Auth)
DATABASE_URL=postgresql+asyncpg://panasa:panasa@localhost:5432/panasa_agent_builder

# Auth
JWT_SECRET=changeme
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173

# Bedrock
BEDROCK_REGION=us-east-1
BEDROCK_DEFAULT_MODEL=anthropic.claude-3-5-sonnet-20241022-v2:0

# Langfuse (LLM Observability)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Redis (Celery)
REDIS_URL=redis://localhost:6379/0
